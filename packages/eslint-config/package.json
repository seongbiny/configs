{
  "name": "@edenyun/eslint-config",
  "version": "1.2.0",
  "type": "module",
  "private": false,
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./next-js": {
      "types": "./next-js.d.ts",
      "default": "./next-js.js"
    },
    "./react-internal": {
      "types": "./react-internal.d.ts",
      "default": "./react-internal.js"
    }
  },
  "files": [
    "index.js",
    "next-js.js",
    "react-internal.js",
    "*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eslint/js": "^9.29.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.2.0",
    "typescript-eslint": "^8.35.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">= 5"
  }
}
